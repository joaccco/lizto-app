# Copy to .env.local (ignored by Git). Supply the API base for the target environment.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public Google OAuth client IDs from the same Google Cloud project.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Facebook SDK client configuration. Never put the Facebook App Secret here.
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
